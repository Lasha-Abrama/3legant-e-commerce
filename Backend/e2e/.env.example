# Isolated MongoDB database used only for browser E2E data.
E2E_MONGO_URL=mongodb+srv://<username>:<password>@<cluster>/threelegant-e2e

# Optional: use an already deployed environment instead of starting Nest locally.
# E2E_BASE_URL=https://your-preview.example.com

# Uses Stripe test mode only. This must remain true for the payment/refund scenario.
E2E_RUN_STRIPE=true
E2E_PORT=5100
