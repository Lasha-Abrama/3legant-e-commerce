# Runtime
NODE_ENV=development
PORT=5000
# Set this to your known reverse proxy configuration when deployed behind one.
# Common Express values include: loopback, linklocal, or a trusted subnet.
TRUST_PROXY=

# Database
MONGO_URL=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# Authentication
# Generate a long, random value for every environment.
JWT_SECRET=replace-with-a-long-random-secret

# Media uploads
CLOUDINARY_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Stripe payments
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
FRONTEND_URL=http://localhost:5000
