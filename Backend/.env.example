# Runtime
NODE_ENV=development
PORT=5000
# Set this to your known reverse proxy configuration when deployed behind one.
# Use a numeric hop count, loopback, linklocal, or a trusted subnet. The unsafe value true is rejected.
TRUST_PROXY=

# Database
MONGO_URL=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# Authentication
# Generate a long, random value for every environment.
JWT_SECRET=replace-with-a-long-random-secret

# Media uploads
CLOUDINARY_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Stripe payments
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
FRONTEND_URL=http://localhost:5000

# Optional password reset email. Configure both values together.
# Without them, production returns a generic response but does not expose or deliver a reset link.
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=Gita_3_Team_2 <noreply@your-domain.com>

# Optional reusable SMTP delivery. Leave credentials and sender blank to disable.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=3legant

# Optional Google OAuth. Configure all three values together.
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Optional development seed administrator. Set both values or leave both blank.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FIRST_NAME=Store
SEED_ADMIN_LAST_NAME=Admin
